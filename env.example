DISCORD_TOKEN=
# Client ID of the GitHub OAuth App (with "Enable Device Flow" ticked). No client secret needed.
GITHUB_CLIENT_ID=
# owner/name of the repository
GITHUB_REPO=owner/repo
CONTRIBUTOR_ROLE_ID=
# channel where the bot posts the "Verify with GitHub" button message
PANEL_CHANNEL_ID=
# optional: a token with no scopes, only to raise the GitHub API rate limit
# (required if the repository is private)
GITHUB_TOKEN=
